<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <PropertyGroup>
    <MyPropertyValue>CustomPropertyValue</MyPropertyValue>
  </PropertyGroup>

  <PropertyGroup>
    <WeaverConfiguration>
      <Weavers>
        <SampleWeaver MyProperty="$(MyPropertyValue)">
          <Content>Override</Content>
        </SampleWeaver>
        <NullGuard IncludeDebugAssert="false" Mode="Explicit" />
        <JetBrainsAnnotations />
      </Weavers>
    </WeaverConfiguration>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit.Core" />
    <PackageReference Include="TUnit.Assertions" />
    <PackageReference Include="TUnit.Engine" />
    <PackageReference Include="Fody" />
    <PackageReference Include="SampleWeaver.Fody" />
  </ItemGroup>

  <!-- Do NOT update these versions, it's for backward compatibility testing!!! -->
  <ItemGroup>
    <PackageReference Include="JetBrainsAnnotations.Fody" PrivateAssets="All" />
    <PackageReference Include="NullGuard.Fody" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\ModuleInitializerAttribute.cs" Link="ModuleInitializerAttribute.cs" />
  </ItemGroup>
</Project>
