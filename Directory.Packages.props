<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- the cecil submodule manages its own package versions -->
    <ManagePackageVersionsCentrally Condition="$(MSBuildProjectFullPath.Contains('cecil'))">false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Build.Tasks.Core" Version="18.10.1" IsPinned="true" PinnedRange="[17.0;18.0)" Justification="V 18 Breaks all tests"/>
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="Nullable" Version="1.3.1" />
    <PackageVersion Include="System.Reflection.Metadata" Version="10.0.12" />
    <PackageVersion Include="System.Runtime.Loader" Version="4.3.0" />
    <!-- the TUnit metapackage is not used since it brings in a Mono.Cecil that conflicts with the Cecil used by Fody -->
    <PackageVersion Include="TUnit.Core" Version="1.69.16" />
    <PackageVersion Include="TUnit.Assertions" Version="1.69.21" />
    <PackageVersion Include="TUnit.Engine" Version="1.69.21" />
    <PackageVersion Include="Verify.TUnit" Version="33.1.4" />
    <PackageVersion Include="JetBrainsAnnotations.Fody" Version="2.17.0" />
    <PackageVersion Include="NullGuard.Fody" Version="3.1.1" />
    <PackageVersion Include="Virtuosity.Fody" Version="3.1.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(IntegrationVersion)' != ''">
    <PackageVersion Include="Fody" Version="$(IntegrationVersion)" />
    <PackageVersion Include="FodyHelpers" Version="$(IntegrationVersion)" />
    <PackageVersion Include="SampleWeaver.Fody" Version="$(IntegrationVersion)" />
  </ItemGroup>
</Project>
