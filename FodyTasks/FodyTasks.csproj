<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net472</TargetFrameworks>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FodyCommon\FodyCommon.csproj" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Nullable" PrivateAssets="All" />
    <!-- 
    Must stick with Microsoft.Build.Utilities.Core 17.11.4 to stay backward compatible.
    It is just a compile time interface reference, and we don't ship this, so there is no risk about any vulnerability.
    At runtime it will use the version installed with dotnet/msbuild, which is e.g. 18.10.1 in the latest .NET SDK, and that version is not vulnerable.
    -->
    <PackageReference Include="Microsoft.Build.Utilities.Core" VersionOverride="17.11.4" NoWarn="NU1903" PrivateAssets="All" IsPinned="true" Justification="Must stick with version 17.11.4 to stay backward compatible - we don't ship this, but depend on the version installed with dotnet/msbuild"/>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\FodyHelpers\Guard.cs" Link="Guard.cs" />
    <Compile Include="..\FodyHelpers\MessageImportance.cs" Link="MessageImportance.cs" />
    <Compile Include="..\FodyHelpers\MessageImportanceDefaults.cs" Link="MessageImportanceDefaults.cs" />
    <Compile Include="..\FodyHelpers\Testing\PeVerifier.cs" Link="Verify\PeVerifier.cs" />
    <Compile Include="..\FodyHelpers\Testing\SdkToolFinder.cs" Link="Verify\SdkToolFinder.cs" />
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="PreparePackagesForIntegrationSolution" BeforeTargets="GenerateNuspec">
    <WriteLinesToFile Lines="&lt;Project&gt;&lt;PropertyGroup&gt;&lt;IntegrationVersion&gt;$(PackageVersion)&lt;/IntegrationVersion&gt;&lt;Verify_SponsorshipExemption&gt;$(Verify_SponsorshipExemption)&lt;/Verify_SponsorshipExemption&gt;&lt;Verify_SponsorshipExemptionUntil&gt;$(Verify_SponsorshipExemptionUntil)&lt;/Verify_SponsorshipExemptionUntil&gt;&lt;/PropertyGroup&gt;&lt;/Project&gt;" File="..\Integration\Directory.Build.props" Overwrite="true" />
  </Target>

</Project>